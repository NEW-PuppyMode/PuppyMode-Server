 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "신고 알림 풀 (complaintExecutor: core 1 / max 2 / queue 20)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "활성 스레드 / 풀 크기",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "executor_active_threads{name=\"complaintExecutor\"}",
     "legendFormat": "활성 스레드",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "executor_pool_size_threads{name=\"complaintExecutor\"}",
     "legendFormat": "풀 크기",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "executor_pool_max_threads{name=\"complaintExecutor\"}",
     "legendFormat": "최대(max)",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "description": "신고 접수 후 Slack/n8n 전송을 처리하는 전용 풀"
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "대기 중인 작업(큐 깊이) / 남은 용량",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
